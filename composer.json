{
  "name": "ttms/ttms",
  "description": "Teacher Training Management System built on Laravel 12",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10",
    "spatie/laravel-permission": "^6.9",
    "barryvdh/laravel-dompdf": "^3.1",
    "maatwebsite/excel": "^3.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.18",
    "nunomaduro/collision": "^8.6",
    "pestphp/pest": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  }
}
